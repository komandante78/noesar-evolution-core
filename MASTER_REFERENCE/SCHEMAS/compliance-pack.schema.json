{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOESAR Compliance Pack",
  "type": "object",
  "required": [
    "id",
    "version",
    "jurisdiction",
    "effective_from",
    "review_by",
    "sources",
    "controls"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "jurisdiction": {
      "type": "string"
    },
    "effective_from": {
      "type": "string"
    },
    "review_by": {
      "type": "string"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "prohibited_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "signature": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
