{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/mnt/cachec/NOESAR_EVOLUTION/.claude/hooks/session-context.sh",
            "timeout": 15,
            "statusMessage": "Reading NOESAR EVOLUTION state digest..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/mnt/cachec/NOESAR_EVOLUTION/.claude/hooks/engineering-orchestrator.sh",
            "timeout": 10,
            "statusMessage": "Applying the engineering orchestrator standard..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/mnt/cachec/NOESAR_EVOLUTION/.claude/hooks/session-close-guard.sh",
            "timeout": 15,
            "statusMessage": "Checking session close state..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/mnt/cachec/NOESAR_EVOLUTION/.claude/hooks/session-end-cleanup.sh",
            "timeout": 5,
            "statusMessage": "Releasing session runtime state..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "/mnt/cachec/NOESAR_EVOLUTION/.claude/hooks/destructive-command-guard.sh",
            "timeout": 10,
            "statusMessage": "Checking command safety..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(rm -rf *)",
      "Bash(docker system prune*)",
      "Bash(docker volume prune*)",
      "Bash(docker compose down -v*)",
      "Bash(git push --force*)"
    ]
  }
}
