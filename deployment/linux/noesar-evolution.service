[Unit]
Description=NOESAR Evolution V0.5.0 development reference runtime
After=local-fs.target
Wants=local-fs.target

[Service]
Type=simple
Environment=NOESAR_HOST=127.0.0.1
Environment=NOESAR_PORT=8088
Environment=NOESAR_ALLOWED_HOSTS=localhost,127.0.0.1,::1
Environment=NOESAR_SECURE_COOKIES=false
Environment=NOESAR_RELEASE_CHANNEL=development
Environment=NOESAR_AUTHORITY_MODE=reference-node
Environment=NOESAR_DATA_PLANE=reference-json
Environment=NOESAR_RUNTIME_ROOT=%h/.local/share/noesar-evolution/noesar
Environment=NOESAR_WORKSPACE=%h/.local/share/noesar-evolution/workspace
ExecStart=/usr/bin/env node %h/.local/share/noesar-evolution/noesar/services/reference-control-plane/src/server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/noesar-evolution
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=default.target
