NOESAR_RELEASE_CHANNEL=production
NOESAR_AUTHORITY_MODE=rust-external
NOESAR_RUST_AUTHORITY_SOCKET=/run/noesar/authority.sock
NOESAR_RUST_AUTHORITY_ATTESTATION=/workspace/attestations/rust-authority.json
NOESAR_DATA_PLANE=postgresql
NOESAR_DATABASE_URL=postgresql://noesar@database/noesar
NOESAR_DATABASE_MIGRATION_ATTESTATION=/workspace/attestations/postgresql.json
