#
# Block D3c (UI-054's third piece): voice as a control tower (D-0123), not an assistant.
# Say the status without looking, approve/reject an already-computed plan hands-free — no
# new server capability, no way to widen what the plan already computed. voice-control.js
# carries the whole reducer/vocabulary/state machine (tested without a browser); app.js and
# index.html wire a mic toggle in the topbar to the SAME runWorkspaceAction the visible
# Approve/Reject buttons already call. See docs/DECISION_LOG.md D-0270.

FROM noesar-evolution:phase4-panels-tui

LABEL org.noesar.phase="4-voice-control"
LABEL org.noesar.block-d="d3c-voice-control"

USER root
COPY --chown=10001:10001 apps/webui-static/ /opt/noesar/apps/webui-static/
USER 10001:10001
