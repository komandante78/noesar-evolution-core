#
# D-0493: repair event.currentTarget-after-await in 3 form-submit handlers
# (#securityPasswordForm, #passkeyAddForm, #passkeyRemoveForm). The DOM nulls
# Event.currentTarget once synchronous dispatch ends, so `.reset()` called after an
# `await` threw a TypeError that the catch displayed as an error toast even though
# the underlying API call had already returned 200 — a real success shown to the
# Owner as a failure. Fixed by capturing `const form=event.currentTarget` once,
# synchronously, before the async body.
#
# Only apps/webui-static/ changed. No Rust rebuild, no server-side change.

FROM noesar-evolution:d0469-model-list-20260815T164217Z

LABEL org.noesar.phase="4-password-form-fix"
LABEL org.noesar.decision="D-0493"

USER root
COPY --chown=10001:10001 apps/webui-static/ /opt/noesar/apps/webui-static/
USER 10001:10001
