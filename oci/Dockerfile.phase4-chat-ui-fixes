#
# Two Owner-reported Chat UI defects, both in apps/webui-static/ only — no server-side
# route or behaviour changed.
#
#   1. Enter in the chat composer did nothing; only Ctrl/Cmd+Enter sent a message. Fixed
#      to the standard chat convention: Enter sends, Shift+Enter inserts a newline.
#      (app.js, the #chatInput keydown listener.)
#   2. The four native <select> toolbar dropdowns (Project/Conversation/Branch/Provider)
#      were reported rendering behind the chat panel below them when opened. Not
#      reproduced in a real headless-Chrome run of this exact markup at 1440x900/100%
#      zoom (dropdown popups painted correctly above everything, confirmed by
#      screenshot and by `document.elementFromPoint` at the select's own coordinates).
#      Applied the standard, safe hardening for this symptom class regardless: an
#      explicit stacking context on .chat-toolbar (position:relative;z-index:5) above
#      .chat-grid (position:relative;z-index:1) — costs nothing, cannot regress the
#      layout (verified: baseline screenshot identical before/after), and is the
#      correct fix if the real cause is a paint-order edge case this run did not hit.
#
# Built with --network=none --pull=false.
FROM noesar-evolution:phase4-session-protocol

USER root
COPY --chown=10001:10001 apps/webui-static/ /opt/noesar/apps/webui-static/
USER 10001:10001
