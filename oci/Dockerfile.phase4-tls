# SPDX-License-Identifier: AGPL-3.0-or-later
#
# D-0198: in-process TLS termination support (Option B in docs/LAN_ACCESS_CONFIGURATION.md
# § TLS) — the product can now terminate TLS itself when the operator supplies
# NOESAR_TLS_CERT_FILE/NOESAR_TLS_KEY_FILE, alongside the existing reverse-proxy path
# (Option A, unchanged). New module src/tls.mjs (resolveTls): a half-configured pair, an
# unreadable file, or a non-PEM file is refused rather than silently falling back to
# plaintext. server.mjs switches between node:http and node:https based on the result;
# secureCookies is implied true automatically once TLS is active. No certificate is
# generated by the product itself — which name it is for and whether it is self-signed or
# CA-issued stays an operator decision, the same reasoning D-0055 already applies to
# NOESAR_BIND_ADDRESS.
#
# The container HEALTHCHECK is updated to try plain HTTP first, then HTTPS with
# certificate verification off (checking its own process on loopback, not a third party)
# — it has no build-time way to know which transport a given deployment will configure.
#
# Only server.mjs (modified) and tls.mjs (new) enter the image. Tests (tls.test.mjs) and
# the smoke tool (tools/tls-smoke.mjs) are not shipped — same as every other test in this
# tree.
#
# Built with --network=none --pull=false.
FROM noesar-evolution:phase4-capability-csrf

USER root
COPY --chown=10001:10001 services/reference-control-plane/src/server.mjs /opt/noesar/services/reference-control-plane/src/server.mjs
COPY --chown=10001:10001 services/reference-control-plane/src/tls.mjs /opt/noesar/services/reference-control-plane/src/tls.mjs
USER 10001:10001

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["node", "-e", "const h=require('node:http'),s=require('node:https');function t(m,o){return new Promise((res,rej)=>{const r=m.get(o,(x)=>{x.resume();res(x.statusCode)});r.on('error',rej);r.setTimeout(4000,()=>r.destroy(new Error('timeout')))})}(async()=>{try{process.exit((await t(h,'http://127.0.0.1:8088/livez'))===200?0:1)}catch(e){try{process.exit((await t(s,{hostname:'127.0.0.1',port:8088,path:'/livez',rejectUnauthorized:false}))===200?0:1)}catch(e2){process.exit(1)}}})()"]
