{
  "$id": "https://schemas.noesar.local/v4/data-plane-status.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "connected": {
      "type": "boolean"
    },
    "migrated": {
      "type": "boolean"
    },
    "mode": {
      "enum": [
        "reference-json",
        "postgresql"
      ]
    },
    "productionReady": {
      "type": "boolean"
    },
    "reason": {
      "type": "string"
    },
    "recognized": {
      "type": "boolean"
    }
  },
  "required": [
    "mode",
    "recognized",
    "connected",
    "migrated",
    "productionReady",
    "reason"
  ],
  "type": "object"
}
