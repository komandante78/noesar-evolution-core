{
  "$id": "https://schemas.noesar.local/v6/rust-build-provenance-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "authorityConformancePassed": {
      "const": true
    },
    "binaryPath": {
      "minLength": 1,
      "type": "string"
    },
    "binarySha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "cargoLockSha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "cargoVersion": {
      "minLength": 1,
      "type": "string"
    },
    "conformanceReportPath": {
      "minLength": 1,
      "type": "string"
    },
    "conformanceReportSha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "createdUtc": {
      "minLength": 1,
      "type": "string"
    },
    "kind": {
      "const": "rust-build-provenance"
    },
    "release": {
      "const": "0.6.0"
    },
    "rustcVersion": {
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "sourceTreeSha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "targetTriple": {
      "minLength": 1,
      "type": "string"
    },
    "testsPassed": {
      "const": true
    },
    "testsReportPath": {
      "minLength": 1,
      "type": "string"
    },
    "testsReportSha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "workspaceManifestSha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "workspacePath": {
      "minLength": 1,
      "type": "string"
    },
    "publiclyVerifiable": {
      "description": "Whether a publicly verifiable signature is present. NOT trusted by any verifier: tools/verify-build-provenance.mjs recomputes the verdict from publicSignature and ignores this field in both directions (D-0589). It is here so a reader can see the claim, never so a checker can rely on it.",
      "type": "boolean"
    },
    "publicSignature": {
      "description": "Ed25519 signature (D-0589) over the document with every key of the signature envelope removed, canonical JSON. Verifiable by anyone holding the public key, which is what PKG-001 position 5's independent audit requires and what the symmetric HMAC signature can never provide.",
      "type": "object",
      "additionalProperties": true,
      "required": ["algorithm", "value", "publicKeyFingerprint"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "value": { "type": "string", "minLength": 1 },
        "publicKeyFingerprint": { "pattern": "^[a-f0-9]{64}$", "type": "string" },
        "signedAt": { "type": "string", "minLength": 1 },
        "covers": { "type": "string", "minLength": 1 },
        "envelopeKeys": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "release",
    "binaryPath",
    "binarySha256",
    "workspaceManifestSha256",
    "cargoLockSha256",
    "rustcVersion",
    "cargoVersion",
    "targetTriple",
    "testsPassed",
    "authorityConformancePassed",
    "createdUtc",
    "workspacePath",
    "sourceTreeSha256",
    "testsReportPath",
    "testsReportSha256",
    "conformanceReportPath",
    "conformanceReportSha256"
  ],
  "type": "object"
}
