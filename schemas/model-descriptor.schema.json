{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOESAR Model Descriptor",
  "type": "object",
  "required": [
    "id",
    "version",
    "publisher",
    "source",
    "license",
    "hashes",
    "formats",
    "workloads",
    "resource_profiles"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "publisher": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "formats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quantizations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "workloads": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runtime_adapters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resource_profiles": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "context": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "advisories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "signature": {
      "description": "D-0521. The publisher's detached ed25519 signature over the canonical JSON of this document with `signature` removed — the same shape a sector-module manifest carries. Without it a descriptor is visible but not acquirable: the digest every later guarantee rests on is a field of this document, so an unsigned one asks to be believed.",
      "type": "object",
      "required": ["algorithm", "value", "publicKeyFingerprint"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "value": { "type": "string" },
        "publicKeyFingerprint": { "type": "string" },
        "signedAt": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
