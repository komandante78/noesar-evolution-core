{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOESAR Model Descriptor",
  "type": "object",
  "required": [
    "id",
    "version",
    "publisher",
    "source",
    "license",
    "hashes",
    "formats",
    "workloads",
    "resource_profiles"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "publisher": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "formats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quantizations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "workloads": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runtime_adapters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resource_profiles": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "context": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "advisories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
