{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOESAR Industry Module Manifest",
  "type": "object",
  "required": [
    "id",
    "version",
    "publisher",
    "trust_level",
    "intended_use",
    "excluded_use",
    "sector",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "publisher": {
      "type": "string"
    },
    "trust_level": {
      "enum": [
        "noesar-official",
        "certified-partner",
        "customer-private",
        "community"
      ]
    },
    "sector": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "intended_use": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excluded_use": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "jurisdictions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "human_oversight": {
      "type": "object"
    },
    "safety_interlock": {
      "type": "object"
    },
    "signature": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
