{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOESAR Runtime Adapter",
  "type": "object",
  "required": [
    "id",
    "version",
    "vendor",
    "devices",
    "runtime_requirements",
    "capabilities"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "vendor": {
      "type": "string"
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runtime_requirements": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "multi_device_modes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "probe": {
      "type": "object"
    },
    "sandbox": {
      "type": "object"
    },
    "license": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
