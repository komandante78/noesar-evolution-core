{
  "engines": {
    "node": ">=22"
  },
  "name": "noesar-evolution-source-v4-implementation",
  "private": true,
  "scripts": {
    "lint": "tools/run-eslint.sh",
    "lint:self-test": "tools/verify-linter-detects.sh",
    "smoke:auth": "node tools/auth-http-smoke.mjs",
    "start": "node services/reference-control-plane/src/server.mjs",
    "test": "node --test services/reference-control-plane/test/*.test.mjs packages/*/test/*.test.mjs",
    "test:accessibility": "NOESAR_E2E_DRIVER=tools/accessibility-audit.mjs bash tools/run-browser-e2e.sh",
    "test:authority": "node --test services/reference-control-plane/test/authority.test.mjs services/reference-control-plane/test/data-plane.test.mjs services/reference-control-plane/test/conformance.test.mjs",
    "test:authority-external": "node --test services/reference-control-plane/test/authority-external-client.test.mjs",
    "test:authority-protocol": "node --test services/reference-control-plane/test/authority-protocol.test.mjs",
    "test:canonical": "node --test services/reference-control-plane/test/canonical-json.test.mjs",
    "test:e2e-retention": "bash tools/test-e2e-retention.sh",
    "test:installers": "node tools/test-installer-hardening.mjs",
    "test:installers-cross-platform": "node tools/test-cross-platform-installers.mjs",
    "test:ipc-frame": "node --test services/reference-control-plane/test/authority-ipc-frame.test.mjs",
    "test:postgres-integration": "node tools/acceptance/postgres-integration.mjs",
    "test:postgres-repository": "node --test services/reference-control-plane/test/postgres-repository.test.mjs",
    "test:readiness": "node --test services/reference-control-plane/test/production-readiness.test.mjs",
    "test:redeploy": "bash tools/deploy/test/redeploy-fixture.sh",
    "test:voice-chain": "node tools/acceptance/voice-chain.mjs",
    "verify": "node tools/verify-source.mjs",
    "verify:migration-manifest": "node tools/generate-migration-manifest.mjs --check",
    "verify:migrations": "python3 tools/verify-postgres-migrations.py",
    "verify:postgres-contract": "python3 tools/verify-postgres-contract.py",
    "verify:rust-provenance": "python3 tools/test-rust-build-provenance.py",
    "verify:rust-source": "python3 tools/verify-rust-authority-source.py",
    "test:conformance-package": "node --test packages/verified-acquisition/test/*.test.mjs"
  },
  "type": "module",
  "version": "0.6.0"
}
