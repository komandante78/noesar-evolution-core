{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOESAR Owner Entitlement",
  "type": "object",
  "required": [
    "installation_id",
    "owner_public_key",
    "capabilities",
    "issued_at",
    "signature"
  ],
  "properties": {
    "installation_id": {
      "type": "string"
    },
    "owner_public_key": {
      "type": "string"
    },
    "device_binding": {
      "type": "object"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "not_before": {
      "type": "string"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "issued_at": {
      "type": "string"
    },
    "signature": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
