  "normalise": [
    {
      "id": "N-001",
      "why": "accents folded — three spellings of the same Italian word must be one",
      "input": "Perché",
      "expect": "perche"
    },
    {
      "id": "N-002",
      "why": "the grave accent a different transcription engine produces",
      "input": "perchè",
      "expect": "perche"
    },
    {
      "id": "N-003",
      "why": "case is dropped, so a transcription that capitalises a sentence still matches a lowercase handle",
      "input": "MEMORIA",
      "expect": "memoria"
    },
    {
      "id": "N-004",
      "why": "punctuation becomes a separator, not nothing",
      "input": "memoria?",
      "expect": "memoria"
    },
    {
      "id": "N-005",
      "why": "a slash is structural in an address and MUST survive",
      "input": "coden/agent/plan",
      "expect": "coden/agent/plan"
    },
    {
      "id": "N-006",
      "why": "a hyphen is structural in a name and MUST survive",
      "input": "coden-tui",
      "expect": "coden-tui"
    },
    {
      "id": "N-007",
      "why": "runs of whitespace collapse and the result is trimmed",
      "input": "  apri   la    memoria  ",
      "expect": "apri la memoria"
    },
    {
      "id": "N-008",
      "why": "digits survive: an entry named with a number must stay reachable by saying the number",
      "input": "Fase 4",
      "expect": "fase 4"
    },
    {
      "id": "N-009",
      "why": "a curly apostrophe is punctuation, not a letter",
      "input": "cosa c’è",
      "expect": "cosa c e"
    },
    {
      "id": "N-010",
      "why": "nullish input is the empty string, never a crash",
      "input": null,
      "expect": ""
    }
  ],
  "content": [
    {
      "id": "C-001",
      "why": "filler is removed one token at a time",
      "input": "apri la memoria",
      "expect": [
        "memoria"
      ]
    },
    {
      "id": "C-002",
      "why": "an English request loses its verb and article too",
      "input": "open the projects",
      "expect": [
        "projects"
      ]
    },
    {
      "id": "C-003",
      "why": "nothing but filler names nothing — this is what makes UNHEARD reachable",
      "input": "open the",
      "expect": []
    },
    {
      "id": "C-004",
      "why": "an EXPLICITLY empty filler set strips nothing — the caller decides what carries no intent, and an implementation that ignored the parameter would silently impose its own language on everyone",
      "input": "apri la memoria",
      "useFiller": false,
      "expect": [
        "apri",
        "la",
        "memoria"
      ]
    },
    {
      "id": "C-005",
      "why": "a multi-word phrase in the set can never match, so both its words remain",
      "input": "per favore",
      "expect": []
    },
    {
      "id": "C-006",
      "why": "content words keep their order",
      "input": "flussi di lavoro",
      "expect": [
        "flussi",
        "lavoro"
      ]
    }
  ],
  "rank": [
    {
      "id": "R-001",
      "why": "the entry's own name, exactly",
      "phrase": "settings",
      "expectRank": 0,
      "expectEntry": "addr-settings"
    },
    {
      "id": "R-002",
      "why": "the rendered Italian label, exactly — this is what makes speaking Italian work",
      "phrase": "impostazioni",
      "expectRank": 2,
      "expectEntry": "addr-settings"
    },
    {
      "id": "R-003",
      "why": "NAME must beat SEGMENT: the bare word is the command, not the panel whose address ends in it",
      "phrase": "plan",
      "expectRank": 0,
      "expectEntry": "cmd-plan"
    },
    {
      "id": "R-004",
      "why": "a full address matches at NAME",
      "phrase": "coden/agent/plan",
      "expectRank": 0,
      "expectEntry": "addr-agent-plan"
    },
    {
      "id": "R-005",
      "why": "a prefix of a name, followed by a separator",
      "phrase": "coden",
      "expectRank": 3,
      "expectEntry": "addr-agent-plan"
    },
    {
      "id": "R-006",
      "why": "a word delimited inside a longer prose handle",
      "phrase": "decisione",
      "expectRank": 5,
      "expectEntry": "addr-approvals"
    },
    {
      "id": "R-007",
      "why": "the group heading answers only where nothing else did",
      "phrase": "approvazioni",
      "expectRank": 7,
      "expectEntry": "addr-approvals"
    },
    {
      "id": "R-008",
      "why": "an utterance whose filler is stripped must still match a label that contains a preposition",
      "phrase": "flussi di lavoro",
      "expectRank": 2,
      "expectEntry": "addr-workflows"
    },
    {
      "id": "R-009",
      "why": "accent folding reaches ranking, not only normalisation",
      "phrase": "perché",
      "expectRank": 2,
      "expectEntry": "addr-why"
    },
    {
      "id": "R-010",
      "why": "nothing but filler ranks nothing at all",
      "phrase": "apri la",
      "expectRank": null
    }
  ],
  "unique": [
    {
      "id": "U-001",
      "why": "one destination reached by two rows is one answer, not a question",
      "utterance": "memoria",
      "expect": "intent:cmd-memory"
    },
    {
      "id": "U-002",
      "why": "a plain navigation request resolves through its filler",
      "utterance": "apri la memoria",
      "expect": "intent:cmd-memory"
    },
    {
      "id": "U-003",
      "why": "an English request resolves the same way",
      "utterance": "open the projects",
      "expect": "intent:addr-projects"
    },
    {
      "id": "U-004",
      "why": "nothing but filler is UNHEARD, distinct from NOTHING",
      "utterance": "apri la",
      "expect": "unheard"
    },
    {
      "id": "U-005",
      "why": "the empty utterance is UNHEARD",
      "utterance": "",
      "expect": "unheard"
    },
    {
      "id": "U-006",
      "why": "a real sentence that names nothing here is NOTHING, not a guess",
      "utterance": "quanti test ci sono nel sistema",
      "expect": "nothing"
    },
    {
      "id": "U-007",
      "why": "a group heading names a room, not a door: several DIFFERENT destinations at the same rank is a real question, so the resolver asks instead of picking — and note the two memory rows appear once, because SI-005 collapses by destination even here",
      "utterance": "applicazioni",
      "expect": "ambiguous:[addr-agent-plan,addr-models,addr-projects,addr-research,addr-settings,addr-why,addr-workflows,cmd-memory,cmd-plan]"
    },
    {
      "id": "U-008",
      "why": "the same two rows that collapse to one destination must still collapse when reached through their Italian label",
      "utterance": "memoria",
      "expect": "intent:cmd-memory"
    }
  ],
  "argument": [
    {
      "id": "A-001",
      "why": "an entry that takes an argument, given one",
      "utterance": "plan fix the build",
      "expect": "intent:cmd-plan (fix the build)"
    },
    {
      "id": "A-002",
      "why": "the argument is returned in the person's OWN words, not normalised",
      "utterance": "plan Fix The Build",
      "expect": "intent:cmd-plan (Fix The Build)"
    },
    {
      "id": "A-003",
      "why": "leading filler is skipped before the head begins",
      "utterance": "please plan fix the build",
      "expect": "intent:cmd-plan (fix the build)"
    },
    {
      "id": "A-004",
      "why": "an entry that takes NO argument cannot have been given one",
      "utterance": "settings something extra",
      "expect": "nothing"
    },
    {
      "id": "A-005",
      "why": "the whole phrase is tried first: a bare name is the name, never a name plus argument",
      "utterance": "plan",
      "expect": "intent:cmd-plan"
    }
  ],
  "compound": [
    {
      "id": "K-001",
      "why": "the case this exists for: navigate AND answer",
      "utterance": "apri la memoria e dimmi cosa c'è dentro",
      "expect": "compound:cmd-memory|dimmi cosa c'è dentro"
    },
    {
      "id": "K-002",
      "why": "\"e poi\" is tried before the \"e\" inside it",
      "utterance": "apri la memoria e poi spiegami",
      "expect": "compound:cmd-memory|spiegami"
    },
    {
      "id": "K-003",
      "why": "English conjunction",
      "utterance": "open settings and tell me what is configured",
      "expect": "compound:addr-settings|tell me what is configured"
    },
    {
      "id": "K-004",
      "why": "the bare \"then\" is a conjunction in its own right, not only the tail of \"and then\"",
      "utterance": "open settings then explain them",
      "expect": "compound:addr-settings|explain them"
    },
    {
      "id": "K-005",
      "why": "ADDITIVE: an utterance that already resolves must never be split",
      "utterance": "apri la memoria",
      "expect": "null"
    },
    {
      "id": "K-006",
      "why": "a sentence that merely CONTAINS \"e\" has a head that resolves to nothing, so nothing splits",
      "utterance": "parlami di gatti e cani",
      "expect": "null"
    },
    {
      "id": "K-007",
      "why": "a tail made only of a connective asked nothing",
      "utterance": "apri la memoria e poi",
      "expect": "null"
    },
    {
      "id": "K-008",
      "why": "an empty tail is not a compound",
      "utterance": "apri la memoria e",
      "expect": "null"
    },
    {
      "id": "K-009",
      "why": "a head that names nothing does not act on a guess",
      "utterance": "qualcosa di inesistente e dimmi altro",
      "expect": "null"
    },
    {
      "id": "K-010",
      "why": "the empty utterance is not a compound",
      "utterance": "",
      "expect": "null"
    }
  ],
