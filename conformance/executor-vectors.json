    {
      "id": "EXEC-010",
      "why": "a shadow built from only the declared paths cannot ever observe an undeclared write, so the executor refuses to run against one at all — before anything is spent or written",
      "bench": {
        "files": {
          "a.txt": "before"
        },
        "destructive": false,
        "shadowCoverage": "DECLARED_PATHS_ONLY",
        "declaredPaths": [
          "a.txt"
        ]
      },
      "mints": [
        {
          "paths": [
            "a.txt"
          ],
          "operations": [
            "WRITE"
          ],
          "uses": 1,
          "plan": "self"
        }
      ],
      "actions": [
        {
          "kind": "WRITE",
          "path": "a.txt",
          "contents": "after"
        }
      ],
      "expectation": {
        "pathsTheDiffMustTouch": [
          "a.txt"
        ]
      },
      "expected": {
        "wholeCallRefused": true,
        "errorKind": "INVALID",
        "shadowFiles": {
          "a.txt": "before"
        }
      }
    },
