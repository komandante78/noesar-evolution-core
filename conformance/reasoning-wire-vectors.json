{
  "schemaVersion": "1.0",
  "contractVersion": "1.0.0",
  "note": "The shared oracle for the boundary between this engine and any external reasoning provider. The vocabulary is this engine's, and an implementation adapts to it. Canonical here because the boundary is part of the open core; a private implementation pins this file rather than owning it. Both halves run it: the client in services/reference-control-plane/test, the provider in its own suite. A boundary described in two places and tested in one has already diverged, it just has not been noticed.",
  "envelope": {
    "success": "{\"ok\":true,\"value\":<surface answer>}",
    "failure": "{\"ok\":false,\"error\":{\"kind\":\"REFUSED|INVALID|UNSUPPORTED|INTERNAL|BAD_REQUEST\",\"reason\":\"...\"}}",
    "statusRule": "The HTTP status describes the transport. A refusal is a legitimate contract answer and travels as 200 with ok:false. A client reading only the status is reading half the answer."
  },
  "cases": [
    {
      "id": "WIRE-001",
      "why": "the identity a caller records provenance from",
      "method": "GET",
      "path": "/v1/identity",
      "body": null,
      "expect": {
        "status": 200,
        "ok": true,
        "value": {
          "name": "atom",
          "contractVersion": "1.0.0",
          "supportsSimulation": true
        }
      }
    },
    {
      "id": "WIRE-002",
      "why": "an empty request has no goal, and the refusal is an answer not an error",
      "method": "POST",
      "path": "/v1/interpret",
      "body": {
        "request": "   ",
        "projectRules": [],
        "mapDigest": "d"
      },
      "expect": {
        "status": 200,
        "ok": false,
        "errorKind": "REFUSED"
      }
    },
    {
      "id": "WIRE-003",
      "why": "the intent shape, in the engine's spelling",
      "method": "POST",
      "path": "/v1/interpret",
      "body": {
        "request": "Repair src/parser.rs. It drops trailing commas.",
        "projectRules": [
          "keep the public API"
        ],
        "mapDigest": "map-1"
      },
      "expect": {
        "status": 200,
        "ok": true,
        "value": {
          "goal": "Repair src/parser.rs"
        },
        "arrayLengths": {
          "ambiguities": 0,
          "successCriteria": 3
        }
      }
    },
    {
      "id": "WIRE-004",
      "why": "a missing map digest is an ambiguity, not something to assume away",
      "method": "POST",
      "path": "/v1/interpret",
      "body": {
        "request": "Repair src/parser.rs",
        "projectRules": [],
        "mapDigest": ""
      },
      "expect": {
        "status": 200,
        "ok": true,
        "arrayLengths": {
          "ambiguities": 1
        }
      }
    },
    {
      "id": "WIRE-005",
      "why": "a provider that searches nothing says NOT_SOUGHT rather than NONE_FOUND",
      "method": "POST",
      "path": "/v1/hypothesize",
      "body": {
        "intent": {
          "goal": "Repair the parser",
          "nonGoals": [],
          "successCriteria": [
            "c"
          ],
          "ambiguities": []
        },
        "gathered": []
      },
      "expect": {
        "status": 200,
        "ok": true,
        "listLength": 1,
        "firstItem": {
          "contrary": "NOT_SOUGHT"
        }
      }
    },
    {
